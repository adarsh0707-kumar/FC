# PostgreSQL connection string.
# Local:  postgresql://USER:PASSWORD@localhost:5432/footballclub
# Hosted: copy the pooled connection string from Neon / Supabase / Render.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret used to sign admin JWTs. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"

# Port the API listens on (defaults to 4000 if unset).
PORT=4000
