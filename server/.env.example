# PostgreSQL connection string.
# Local:  postgresql://USER:PASSWORD@localhost:5432/footballclub
# Hosted: copy the pooled connection string from Neon / Supabase / Render.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret used to sign admin JWTs. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"

# Port the API listens on (defaults to 4000 if unset).
PORT=4000

# Public URL of the frontend. Password-reset links are built from this.
# Production example: https://your-club.vercel.app
CLIENT_URL=http://localhost:5173

# SMTP connection string for password-reset emails. Any provider works.
#   smtps://apikey:SG.xxxx@smtp.sendgrid.net:465
#   smtps://resend:re_xxxx@smtp.resend.com:465
# Leave unset in local development: the reset link is printed to the server log
# instead of being emailed.
# SMTP_URL=
# MAIL_FROM="Football Club <no-reply@yourdomain.com>"

# Set when running behind a reverse proxy (Render, Railway, nginx) so that
# rate limiting sees the real client IP rather than the proxy's. Value is the
# number of proxy hops to trust — 1 is right for Render/Railway.
# TRUST_PROXY=1
